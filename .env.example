# ─── Database ────────────────────────────────────────────────────────────────
DB_PATH=./data/podo.db
# Where drizzle migrations are read from. The Docker image points this at the
# compiled copy under dist/.
# MIGRATIONS_PATH=./src/db/migrations

# ─── Auth ────────────────────────────────────────────────────────────────────
# Required in production — the server refuses to start with the default value.
JWT_SECRET=change-me-in-production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# ─── Server ──────────────────────────────────────────────────────────────────
PORT=3000
HOST=0.0.0.0
# STATIC_DIR=./web/dist   # web frontend build output; Docker sets this to /app/public
# CORS_ORIGIN=*
# TRUST_PROXY=true        # set false when NOT behind a reverse proxy
# RATE_LIMIT_MAX=1000     # requests/minute/IP, all routes
# AUTH_RATE_LIMIT_MAX=10  # requests/minute/IP, login+register+refresh only
# SWAGGER_ENABLED=false   # /api/docs is on by default outside production

# ─── Library ─────────────────────────────────────────────────────────────────
LIBRARY_ROOTS=/music
UPLOAD_DIR=./data/uploads
ARTWORK_DIR=./data/artwork
TRANSCODE_CACHE_DIR=./data/transcode-cache
# YTDLP_PATH=yt-dlp

# ─── Update check ────────────────────────────────────────────────────────────
# Asks GitHub once every 12h whether a newer Podo has been released, and shows
# the answer to admins. One unauthenticated GET; nothing about this instance is
# sent. Set false to disable it entirely.
# UPDATE_CHECK_ENABLED=true
# UPDATE_CHECK_REPO=byeolki/podo
# APP_VERSION=            # overrides the version read from package.json

# ─── External APIs (all optional) ────────────────────────────────────────────
# Identifies this deployment to MusicBrainz; requests without a real UA get
# rate-limited or rejected.
MUSICBRAINZ_USER_AGENT=podo/0.1.0 (https://github.com/yourname/podo)
# ─── AI ──────────────────────────────────────────────────────────────────────
# Fills track metadata from filenames, and (optionally) runs the chat assistant
# that can search, queue and organise your library. Everything here is only a *default* — an admin can change
# the provider, the model and the switches from Settings → AI at runtime.
#
# Two providers:
#   openai       needs OPENAI_API_KEY
#   claude-code  runs the Claude Code CLI bundled in the image; needs
#                ANTHROPIC_API_KEY, or an authenticated config mounted at
#                /root/.claude
#
# Nothing is chosen implicitly: with none of these set, AI is off. Naming a
# provider or supplying a key turns it on; AI_ENABLED=true is the way to enable
# it with the CLI provider and no key.
# AI_ENABLED=true
# AI_PROVIDER=openai
# AI_CHAT_ENABLED=false      # the assistant; it can create playlists, so off by default
# OPENAI_API_KEY=
# OPENAI_MODEL=              # defaults to gpt-5.4
# ANTHROPIC_API_KEY=
# CLAUDE_CODE_PATH=claude
# CLAUDE_MODEL=              # defaults to claude-sonnet-5
# Where the CLI looks for `.claude`. It runs with a scrubbed environment, so
# point this at whatever you mounted an authenticated config into — the server's
# own HOME is used when unset.
# CLAUDE_CONFIG_HOME=/claude-home
