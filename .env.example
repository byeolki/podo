# ─── Database ────────────────────────────────────────────────────────────────
DB_PATH=./data/podo.db
# Where drizzle migrations are read from. The Docker image points this at the
# compiled copy under dist/.
# MIGRATIONS_PATH=./src/db/migrations

# ─── Auth ────────────────────────────────────────────────────────────────────
# Required in production — the server refuses to start with the default value.
JWT_SECRET=change-me-in-production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# ─── Server ──────────────────────────────────────────────────────────────────
PORT=3000
HOST=0.0.0.0
# STATIC_DIR=./web/dist   # web frontend build output; Docker sets this to /app/public
# CORS_ORIGIN=*
# TRUST_PROXY=true        # set false when NOT behind a reverse proxy
# RATE_LIMIT_MAX=1000     # requests/minute/IP, all routes
# AUTH_RATE_LIMIT_MAX=10  # requests/minute/IP, login+register+refresh only
# SWAGGER_ENABLED=false   # /api/docs is on by default outside production

# ─── Library ─────────────────────────────────────────────────────────────────
LIBRARY_ROOTS=/music
UPLOAD_DIR=./data/uploads
ARTWORK_DIR=./data/artwork
TRANSCODE_CACHE_DIR=./data/transcode-cache
# YTDLP_PATH=yt-dlp

# ─── External APIs (all optional) ────────────────────────────────────────────
# Identifies this deployment to MusicBrainz; requests without a real UA get
# rate-limited or rejected.
MUSICBRAINZ_USER_AGENT=podo/0.1.0 (https://github.com/yourname/podo)
# Set to enable LLM metadata extraction during scans and the "AI Fill" action.
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
